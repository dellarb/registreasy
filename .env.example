# Required: long, random secret; do not commit .env.
PUSH_PASSWORD=change-me-to-a-long-random-secret
PUSH_USERNAME=push

# Blank means anonymous pulls.
PULL_PASSWORD=
PULL_USERNAME=pull

# Two endpoints, same container and image storage.
# Terminate TLS for BOTH endpoints with NPM or another trusted proxy.
BIND_ADDRESS=127.0.0.1
PORT=5000
PUSH_PORT=5002
