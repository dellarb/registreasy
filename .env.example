# Both required: long, random secrets; do not commit .env.
# Generate with e.g. `openssl rand -base64 32`.
PUSH_PASSWORD=change-me-to-a-long-random-secret
PUSH_USERNAME=push
PULL_PASSWORD=change-me-to-another-long-random-secret
PULL_USERNAME=pull

# One endpoint for pulls and pushes. Terminate TLS with NPM or another trusted proxy.
BIND_ADDRESS=127.0.0.1
PORT=5000

# Plain HTTP is accepted only from private (LAN/VPN) addresses. Set to 1 when the
# registry is reachable from the internet to refuse plain HTTP entirely.
REQUIRE_HTTPS=0
# Web sign-in: signed out after this much inactivity, and after this long in total.
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=43200
