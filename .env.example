# Required. Use a long, random secret; do not commit your real .env.
PUSH_PASSWORD=change-me-to-a-long-random-secret
PUSH_USERNAME=push

# Leave empty to allow anyone with network access to pull images.
PULL_PASSWORD=
PULL_USERNAME=pull

# The container only serves HTTP. Terminate HTTPS at a trusted reverse proxy.
BIND_ADDRESS=127.0.0.1
PORT=5000
